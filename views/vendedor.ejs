<!DOCTYPE html>
<html lang="pt-br">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Página do Vendedor</title>
    <link rel="stylesheet" href="/css/global2.css" />
    <link rel="stylesheet" href="/css/pagina-vendedor.css" />
  </head>

  <body>
    <header></header>
    <main>
      <h1>Olá Vendedor, o que deseja?</h1>
      <section>
        <div class="card">
          <h3>Vendedor <%= comerciante.nome %></h3>
          <p>No visu desde <%= new Date(comerciante.data).toLocaleDateString("pt-BR") %></p>
        </div>
        <div class="menu-da-loja">
          <div id="menu-lateral">
            <!-- ainda não está totalmente funcional -->
            <p>Menu:</p>
            <hr />
            <ul>
              <li>
                <a href="/vendedor/<%= comerciante.nome %>/produtos/novo">Adicionar Produtos</a>
              </li>
              <li>
                <a href="/vendedor/<%= comerciante.nome %>/produtos/listar">Editar Produtos</a>
              </li>
              <li>
                <a href="/vendedor/3-alertas-baixa-quantidade"
                  >Alertas de Baixa Quantidade</a
                >
              </li>
              <li>
                <a href="/vendedor/4-visualizacao-estatisticas"
                  >Visualização de Estatísticas</a
                >
              </li>
            </ul>
          </div>
          <div id="menu-central">
            <% produtos.forEach((produto) => { %>
            <div class="produto-item" id="<%= produto.id %>" data-id="<%= produto.id %>">
                <h3><%= produto.nome %></h3>
                <img src="/imagens/<%= produto.imagem %>" alt="<%= produto.nome %>" width="100"/>
                <p>Preço: R$<%= produto.preco.toFixed(2) %></p>
                <p>Quantidade em estoque: <%= produto.quantidade %></p>
            </div>
            <% }) %>
          </div>
        </div>
      </section>
    </main>
  </body>
</html>
