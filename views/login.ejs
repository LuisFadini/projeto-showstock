<!DOCTYPE html>
<html lang="pt-br">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Cadastro</title>
    <link rel="stylesheet" href="/css/global1.css" />
    <link rel="stylesheet" href="/css/cadastro.css" />
  </head>

  <body>
    <main>
      <div id="logo-titulo">
        <div id="logocarrinho"></div>
        <div id="logovisu"></div>
      </div>
      <section class="campos-inputs">
        <h1 id="txtCadastro">Login</h1>

        <label for="inEmail"></label>
        <input type="text" id="inEmail" name="email" placeholder="Email" />

        <label for="inSenha"></label>
        <input type="password" id="inSenha" name="senha" placeholder="Senha" />

        <input type="button" id="btCadastrar" value="Login" />
        <input
          type="button"
          value="Entrar sem login"
          id="btEntrar"
          class="btn-verde"
        />
        <p id="rodape">Não tem VISU? <a id="btMudar" href="/cadastro">Faça o cadastro!</a></p>
      </section>
    </main>
    <script src="/js/mensagem_alerta.js"></script>
    <script src="/js/login.js"></script>
  </body>
</html>
